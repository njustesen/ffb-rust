+/// Java `UtilPlayer.findPlayersWithTackleZonesTwoSquaresAway(game, team, coord).length > 0`:
+/// `findPlayersWithTackleZones(.., 2)` walks `findAdjacentCoordinates(coord, FIELD, 2, false)`
+/// (the 5x5 box minus its centre, clipped to the field) and keeps a `team` player whose base is
+/// exactly STANDING and who is not Distracted.
+fn opponent_standing_within_two(
+    game: &Game,
+    team: &ffb_model::model::team::Team,
+    coord: FieldCoordinate,
+) -> bool {
+    team.players.iter().any(|p| {
+        let Some(c) = game.field_model.player_coordinate(&p.id) else { return false };
+        let in_box = (c.x - coord.x).abs() <= 2 && (c.y - coord.y).abs() <= 2 && c != coord;
+        in_box
+            && (0..=25).contains(&c.x)
+            && (0..=14).contains(&c.y)
+            && game.field_model.player_state(&p.id)
+                .is_some_and(|s| s.base() == ffb_model::enums::PS_STANDING && !s.is_distracted())
+    })
+}
