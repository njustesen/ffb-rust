+    /// Client `LogicModule.isSecureTheBallActionAvailable`: any player, not only one on the ball
+    /// square, unless an opposing STANDING non-Distracted player is within 2 squares of the ball
+    /// (the ball square itself excluded), or the player is a Big Guy.
+    #[test]
+    fn secure_the_ball_follows_client_terms() {
+        let base = || {
+            let mut game = make_game(Rules::Bb2025);
+            add_player(&mut game, true, "p1", c(2, 2), PS_STANDING, vec![]);
+            game.field_model.ball_coordinate = Some(c(10, 7));
+            game.field_model.ball_in_play = true;
+            game.field_model.ball_moving = true;
+            game
+        };
+        // Far from the ball, nobody near it: offered.
+        let game = base();
+        assert!(has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+        // A standing opponent two squares from the ball: not offered.
+        let mut game = base();
+        add_player(&mut game, false, "o1", c(12, 9), PS_STANDING, vec![]);
+        assert!(!has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+        // Three squares away, or prone within two: offered.
+        let mut game = base();
+        add_player(&mut game, false, "o1", c(13, 7), PS_STANDING, vec![]);
+        add_player(&mut game, false, "o2", c(11, 7), PS_PRONE, vec![]);
+        assert!(has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+        // A team-mate next to the ball does not block it.
+        let mut game = base();
+        add_player(&mut game, true, "p2", c(11, 7), PS_STANDING, vec![]);
+        assert!(has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+        // Big Guy keyword: not offered.
+        let mut game = base();
+        game.team_home.players[0].keywords = vec!["Big Guy".into()];
+        assert!(!has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+        // Ball held (not moving): not offered.
+        let mut game = base();
+        game.field_model.ball_moving = false;
+        assert!(!has_action(&legal_activate_player_actions(&game, TeamSide::Home), "p1", PlayerActionChoice::SecureTheBall));
+    }
