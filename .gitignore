**/target/
**/*.class
**/.DS_Store

# ── Generated by parity runs — regenerable, never pushed ──────────────────────
# Per-seed engine logs. ~7k files / 2.1 GB, rewritten by EVERY gate run, so
# tracking them left `git status` permanently noisy — which is how 87 untracked
# roster XMLs and a load-bearing harness change went unnoticed for sessions.
# They are also unsafe to read after an aborted run (they go stale silently).
ffb-rust/parity/
# The --agent random control's own root (FFB_PARITY_ROOT=parity_random), so it can never
# overwrite the heuristic gate's evidence in ffb-rust/parity/.
ffb-rust/parity_random/

# Coverage reports, rewritten on every ffb-parity invocation.
ffb-rust/T3_COVERAGE.md
ffb-rust/t3_coverage.html
ffb-rust/uniform_coverage.html

# More coverage output, written by ffb-parity on each run.
ffb-rust/FULL_MECHANIC_COVERAGE.md
ffb-rust/coverage.html
ffb-rust/coverage*.json
# Rewritten by update_progress.rs after EVERY seed result.
ffb-rust/progress.html

# Trace dumps and gate logs captured while debugging (cj/cr/drive/rust_trace are
# raw engine traces; gate_all.log is a matrix run's stdout).
ffb-rust/cj.txt
ffb-rust/cr.txt
ffb-rust/drive.txt
ffb-rust/rust_trace.txt
ffb-rust/gate_all.log
ffb-rust/scratchpad/

# Build/probe scratch and Python bytecode.
ffb-rust/target-probe/
**/__pycache__/

# NOT ignored, deliberately: ffb-java/**/rosters/*.xml and teams/*.xml. They are
# generated by scripts/gen_java_parity_data.py but are load-bearing - the Java
# engine builds its squads from them, and the gate is only meaningful if both
# engines field the SAME team.

# Rendered decision-replay frames (46MB, regenerate with scripts/render_decisions.py)
seed1_sampled_frames/
